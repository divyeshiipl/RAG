<Window x:Class="RAG.Testing.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RAG.Testing.Desktop"
        mc:Ignorable="d"
        Title="RAG Desktop" Height="760" Width="1120" WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Question label -->
        <TextBlock Grid.Row="0"
                   Text="Question:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <!-- Question input -->
        <TextBox x:Name="QuestionBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="70"
                 MaxHeight="140"
                 Padding="4"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,8">
            <Button x:Name="AskButton"
                    Content="Ask"
                    Width="100"
                    Height="30"
                    Click="AskButton_Click"/>
            <Button x:Name="ClearButton"
                    Content="Clear"
                    Width="100"
                    Height="30"
                    Margin="8,0,0,0"
                    Click="ClearButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="30"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <!-- Answer label -->
        <TextBlock Grid.Row="3"
                   Text="AI Answer:"
                   FontWeight="SemiBold"
                   Margin="0,4,0,4"/>

        <!-- Answer output -->
        <RichTextBox x:Name="AnswerBox"
                     Grid.Row="4"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"
                     Padding="6"/>

        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>
